 describe("flowing selection motion", () => {
+  it.each([{ width: 0, height: 30 }, { width: 64, height: 0 }, { width: 0, height: 0 }])("defers zero-size visual copies (%o) while retaining selection and observing reveal", async (hiddenSize) => {
+    let notifyResize!: ResizeObserverCallback;
+    const observe = vi.fn(), disconnect = vi.fn();
+    const OriginalResizeObserver = window.ResizeObserver;
+    window.ResizeObserver = class {
+      constructor(callback: ResizeObserverCallback) { notifyResize = callback; }
+      observe = observe;
+      unobserve = vi.fn();
+      disconnect = disconnect;
+    };
+    try {
+      const { group, items, boxes, controller } = fixture();
+      boxes.forEach(box => { Object.assign(box, hiddenSize); });
+      controller.update({ animate: false });
+      const foreground = group.querySelector<HTMLElement>("[data-selection-motion-foreground]")!;
+      expect(foreground.hidden).toBe(true);
+      expect(foreground.querySelectorAll("[data-selection-motion-label]")).toHaveLength(0);
+      expect(items.every(item => item.hasAttribute("data-selection-motion-item"))).toBe(true);
+      expect(observe).toHaveBeenCalledWith(group);
+      items.forEach(item => expect(observe).toHaveBeenCalledWith(item));
+      await act(async () => {
+        items[0].setAttribute("aria-selected", "false");
+        items[1].setAttribute("aria-selected", "true");
+        items[1].textContent = "Revealed translation";
+      });
+      expect(items[1].hasAttribute("data-selection-motion-selected")).toBe(true);
+      expect(items[0].hasAttribute("data-selection-motion-selected")).toBe(false);
+      expect(foreground.children).toHaveLength(0);
+      boxes[1].width = 130; boxes[1].height = 30;
+      await act(async () => {
+        notifyResize([], {} as ResizeObserver);
+        await new Promise(requestAnimationFrame);
+      });
+      expect(foreground.hidden).toBe(false);
+      expect(foreground.querySelectorAll("[data-selection-motion-label]")).toHaveLength(1);
+      expect(foreground.textContent).toBe("Revealed translation");
+      expect(foreground.getAttribute("aria-hidden")).toBe("true");
+      expect(foreground.hasAttribute("inert")).toBe(true);
+      expect(foreground.querySelectorAll("button,input,[id],[role],[tabindex]")).toHaveLength(0);
+      controller.destroy();
+      expect(disconnect).toHaveBeenCalled();
+      expect(group.querySelectorAll("[data-selection-motion-overlay]")).toHaveLength(0);
+      expect(items.every(item => !item.hasAttribute("data-selection-motion-item"))).toBe(true);
+    } finally {
+      window.ResizeObserver = OriginalResizeObserver;
+    }
+  });
